{
  "name": "@blcklab/porma-compiler",
  "version": "0.1.0-rc.3",
  "description": "Dependency-free .blck compiler for Porma.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "porma",
    "compiler",
    "blck",
    "frontend"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "types": "./src/index.d.ts",
  "scripts": {
    "test": "node --test test/*.test.js",
    "pack:dry-run": "npm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blcklab/porma.git",
    "directory": "packages/porma-compiler"
  },
  "bugs": {
    "url": "https://github.com/blcklab/porma/issues"
  },
  "homepage": "https://github.com/blcklab/porma#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
