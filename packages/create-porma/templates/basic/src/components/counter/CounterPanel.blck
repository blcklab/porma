<logic>
import Button from '../ui/Button.blck'

const inherited = defineInherits()

function increment() {
  inherited.count.value++
}

function reset() {
  inherited.count.value = 0
}
</logic>

<view>
  <section class="counter-panel">
    <div>
      <p class="label">Inherited count</p>
      <strong>{count}</strong>
    </div>

    <div class="actions">
      <Button label="Increment" onClick={increment} />
      <Button label="Reset" variant="subtle" onClick={reset} />
    </div>
  </section>
</view>

<style scoped>
.counter-panel {
  align-items: center;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 1.25rem;
  display: flex;
  gap: 1rem;
  justify-content: space-between;
  padding: 1.25rem;
}

.label {
  color: #64748b;
  margin: 0 0 0.25rem;
}

strong {
  font-size: 2.5rem;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}
</style>
