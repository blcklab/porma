<logic>
import Button from '../components/ui/Button.blck'

const inherited = defineInherits()

function increment() {
  inherited.count.value++
}
</logic>

<view>
  <section class="page-card">
    <p class="eyebrow">Home</p>
    <h2>Welcome to your routed Porma app</h2>
    <p>Route state is installed separately through @blcklab/porma-router.</p>

    <div class="counter-row">
      <strong>{count}</strong>
      <Button label="Increment inherited count" onClick={increment} />
    </div>

    <ul>
      <li loop="todo in todos" key={todo.id}>{todo.text}</li>
    </ul>
  </section>
</view>

<style scoped>
.page-card {
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 1.25rem;
  padding: 1.25rem;
}

