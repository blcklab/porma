<logic lang="ts">
const props = defineProps<{
  label?: string
  onClick?: () => void
  variant?: 'primary' | 'subtle'
}>({
  label: { default: 'Button' },
  onClick: { default: null },
  variant: { default: 'primary' }
})
</logic>

<view>
  <button class={['button', props.variant]} on.click={props.onClick}>
    {props.label}
  </button>
</view>

<style scoped>
.button {
  border: 0;
  border-radius: 0.9rem;
  cursor: pointer;
  font: inherit;
  font-weight: 700;
  padding: 0.75rem 1rem;
}

.primary {
  background: #111827;
  color: white;
}

.subtle {
  background: #e5e7eb;
  color: #111827;
}
</style>
