<logic lang="ts">
import { signal, shared, type Signal } from '@blcklab/porma'
import { appConfig } from './app/config.js'
import { initialTodos } from './lib/todos.js'
import type { Todo } from './types/app.d.ts'
import AppShell from './layouts/AppShell.blck'
import HomePage from './pages/Home.blck'

const appTitle = signal<string>(appConfig.name)
const count = shared(signal<number>(0))
const todos = shared(signal<Todo[]>(initialTodos))
</logic>

<view>
  <AppShell />
  <HomePage />
</view>
